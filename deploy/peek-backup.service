# /etc/systemd/system/peek-backup.service, installed by deploy/install.sh (BLUEPRINT §5.2).
# One online SQLite snapshot of /var/lib/peek/peek.sqlite, integrity-checked and copied
# to s3://<ArtifactBucket>/backups/ with SSE (the bucket expires backups/ after 7 days).
# Runs as the peek user; /etc/peek/backup.env names the bucket and region only (no secrets).
[Unit]
Description=Snapshot Silicon Peek SQLite databases to encrypted S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=peek
Group=peek
EnvironmentFile=/etc/peek/backup.env
Environment=HOME=/var/lib/peek
ExecStart=/usr/bin/python3 /opt/peek/current/backup.py
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# SQLite needs write access to the -shm file even to read a WAL database.
ReadWritePaths=/var/lib/peek
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
