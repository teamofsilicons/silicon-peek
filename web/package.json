  "version": "0.4.0",
  "description": "Landing page and documentation for peek, a Next.js static export for https://peek.teamofsilicons.com.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4317",
