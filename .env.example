# Peek backend; production secrets live in AWS Secrets Manager.
PEEK_BIND=127.0.0.1:8080
PEEK_DATABASE_PATH=/var/lib/peek/peek.sqlite
PEEK_PUBLIC_ORIGIN=https://backend.peek.teamofsilicons.com
PEEK_WEB_ORIGINS=https://peek.teamofsilicons.com
PEEK_ENVIRONMENT=production
PEEK_TING_BASE_URL=https://backend.ting.teamofsilicons.com
PEEK_TING_REQUEST_TIMEOUT_SECONDS=15
PEEK_ENCRYPTION_KEY=
PEEK_ELEVENLABS_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
PEEK_OPENAI_API_KEY=
PEEK_OPENAI_BASE_URL=https://api.openai.com
PEEK_DEEPGRAM_API_KEY=
PEEK_DEEPGRAM_BASE_URL=https://api.deepgram.com
PEEK_DEEPGRAM_TOKEN_TTL_SECONDS=30
PEEK_DEEPGRAM_MIP_OPT_OUT=true
PEEK_BYO_DEEPGRAM_HOSTS=
PEEK_GITHUB_ISSUES_TOKEN=
PEEK_GITHUB_REPO=teamofsilicons/silicon-peek
PEEK_GITHUB_API_URL=
PEEK_TELEMETRY=on
PEEK_BACKEND_TABLE_KEY=
PEEK_CLIDAEMON_TABLE_KEY=
PEEK_FRONTEND_ANALYTICS_TABLE_KEY=
PEEK_FRONTEND_EVENTS_TABLE_KEY=
PEEK_TELEMETRY_HOME=/var/lib/peek/telemetry
PEEK_TELEMETRY_URL=https://backend.spacestation.teamofsilicons.com
RUST_LOG=info,peek=info
PEEK_ACCOUNTS_BASE_URL=https://accounts.teamofsilicons.com
PEEK_ACCOUNTS_APP_ID=peek
PEEK_ACCOUNTS_APP_SECRET=
PEEK_ACCOUNTS_WEBHOOK_SECRET=
