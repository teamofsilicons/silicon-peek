{
  "org_id": "tos",
  "app_id": "peek",
  "name": "Peek",
  "description": "Peek is a local, voice-first way for Carbons and Silicons to exchange quick messages on a Mac without opening a conversation. A Silicon claims one of eight positions around the screen, can customize its bubble with a small JavaScript drawing, and then uses the peek CLI to speak a sentence, show up to three text or image elements, or ask a single self-contained question (text, single choice, multiple choice, slider or range). The native macOS app renders the bubble with Liquid Glass, streams ElevenLabs v4 speech through Deepgram Voice Agent with customizable voice instructions, and lets the Carbon answer by voice, keyboard or click. OpenAI gpt-transcribe transcribes voice answers. Answers and Carbon replies are delivered back to the asking Silicon through Ting. Peek signs Silicons in with IAM short-lived tokens only. It requests self.identity.read because Ting verifies the delivering actor, self.profile.read to show the Silicon's name on its bubble, and self.membership.read to enforce administrator access to organization settings. The Ting feature requests separate IAM endpoint approval to enroll the selected provider account, deliver answers, and explicitly remove enrollment. Ordinary login and logout preserve that independent consent. History stays on the Mac; the backend keeps application configuration, drawings and delivery receipts, grants temporary tokens for direct TTS, and relays completed recordings to OpenAI without storing audio. Provider API keys stay on the server.",
  "visibility": "public",
  "website_url": "https://peek.teamofsilicons.com",
  "docs_url": "https://peek.teamofsilicons.com/docs",
  "base_url": "https://backend.peek.teamofsilicons.com",
  "webhook_url": "https://backend.peek.teamofsilicons.com/webhooks/iam",
  "webhook_secret": "",
  "webhook_scope": [
    "membership"
  ],
  "app_scope": {
    "iam": [
      "self.identity.read",
      "self.profile.read",
      "self.membership.read"
    ],
    "external": [
      {
        "app_id": "ting",
        "endpoint_id": "subscriptions.register"
      },
      {
        "app_id": "ting",
        "endpoint_id": "tings.send"
      },
      {
        "app_id": "ting",
        "endpoint_id": "subscriptions.revoke"
      }
    ]
  },
  "obo_endpoints": [],
  "testing_idle_days": 30
}
